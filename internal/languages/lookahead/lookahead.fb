grammar Lookahead;

interface Obj {
    Value string
    Node composite
}

interface Root {
    Item Obj
}

entry Root: Item=Obj;

Obj: A | B | C | D | E | F | G | H | I;

// Assert that the Path composite alternative is evaluated correctly
A returns Obj: LETTER_A Node=QualifiedPath;

interface B extends Obj {
    Post string
}

// Assert that the QualifiedName lookahead respects the outer context
// Should correctly parse the Post value even though the QualifiedName could be greedy
B: LETTER_B Node=QualifiedPath DOT Post=ID;

composite QualifiedName: ID (DOT ID)*;
composite Path: ID (SLASH ID)* COLON ID | ID;
composite QualifiedPath: QualifiedName DOUBLE_COLON Path | Path;

// Assert that the CLoop rule (theoretically LL(1)) correctly dips into outer context for prediction
C returns Obj: LETTER_C Node=CLoop (DOUBLE_COLON Value=DOUBLE_ASTERISK)?;

composite CLoop: ID (DOUBLE_COLON ID)*; 

// Assert that the DOpt rule (theoretically LL(1)) correctly dips into outer context for prediction
D returns Obj: LETTER_D Node=DOpt (DOUBLE_COLON Value=DOUBLE_ASTERISK)?;

composite DOpt: ID (DOUBLE_COLON ID)?;

E returns Obj: LETTER_E Value=HELLO? WORLD?;

F returns Obj: LETTER_F (ID* Value=HELLO | ID* Value=WORLD);

G returns Obj: LETTER_G (
    Node=QualifiedName Value=HELLO 
    | Node=QualifiedName Value=WORLD
);

H returns Obj: LETTER_H (
    Node=QualifiedNameRecursive Value=HELLO 
    | Node=QualifiedNameRecursive Value=WORLD
);

I returns Obj: LETTER_I (
    // Ambiguous alternatives
    // TODO: Implement warning for those
    Node=QualifiedNameRecursive Value=ID
    | Node=QualifiedNameRecursive Value=ID
);

composite QualifiedNameRecursive: ID (DOT QualifiedNameRecursive)?;

token LETTER_A: "a"
token LETTER_B: "b"
token LETTER_C: "c"
token LETTER_D: "d"
token LETTER_E: "e"
token LETTER_F: "f"
token LETTER_G: "g"
token LETTER_H: "h"
token LETTER_I: "i"
token COMMA: ","
token DOT: "."
token DOUBLE_ASTERISK: "**"
token DOUBLE_COLON: "::"
token COLON: ":"
token SLASH: "/"
token HELLO: "hello"
token WORLD: "world"

token WS: /[ \t\r\n]+/
token ID: /\w[\w0-9]*/

token mode default {
    LETTER_A
    LETTER_B
    LETTER_C
    LETTER_D
    LETTER_E
    LETTER_F
    LETTER_G
    LETTER_H
    LETTER_I
    COMMA
    DOT
    DOUBLE_ASTERISK
    DOUBLE_COLON
    COLON
    SLASH
    HELLO
    WORLD

    ID
    hidden WS
}
