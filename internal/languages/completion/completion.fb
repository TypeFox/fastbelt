grammar Completion;

// Empty obj, we don't care about the actual AST structure for completion testing
interface Obj {}

interface Root {
    Objects []Obj
}

entry Root: Objects+=(Declare | Seq | Alt | Prefix | Call | RefFQN | RefList | RefID | Member | MemberNoDot | RefOrKeyword | Dedup | Opt | Group | RefGroup | RefAction | Scope | Loop | Chain | Infix | Wrap | Shadow | Nest | Ambig | Retype | Dep)*;

interface Declare extends Obj {
    Name composite
    Children []Declare
}

Declare: DECLARE Name=FQN (LBRACE Children+=Declare* RBRACE)?;

composite FQN: ID (DOT ID)*;

// straight-line continuation
Seq returns Obj: "seq" FIRST;

// flat alternative - both branches must stay live post-commit
Alt returns Obj: "alt" (FIRST | SECOND);

// shared-prefix alternative - keep both alts past the prefix
Prefix returns Obj: "prefix" (COMMON FIRST | COMMON SECOND);

// rule-call alternative with shared prefix (CallLong/CallShort)
Call returns Obj: "call" (CallLong | CallShort);

CallLong returns Obj: COMMON THEN LONG;
CallShort returns Obj: COMMON;

interface RefFQN extends Obj {
    Ref *Declare
}

// cross-reference via FQN composite
RefFQN: "fqn" Ref=[Declare:FQN];

interface RefList extends Obj {
    Items []RefListItem
}

// nested rule with RefListItem children (synthetic chain coverage)
RefList: "list" Items+=RefListItem+;

interface RefListItem {
    Ref *Declare
}

RefListItem: Ref=[Declare:FQN];

interface RefID extends Obj {
    Ref *Declare
}

// cross-reference via plain ID
RefID: "ref" Ref=[Declare:ID];

interface Member extends Obj {
    Call MemberCall
}

interface MemberCall {
    Ref *Declare
    Previous MemberCall
}

// cross-references with tree-rewriting actions (member calls)
Member: "member" Call=MemberCall;

// same as Member, but without the dot to separate chained calls
// ensures that synthetic references can properly complete
MemberNoDot returns Member: "nodot" Call=MemberCallNoDot;

MemberCall: Ref=[Declare:ID] ({MemberCall.Previous=current} DOT Ref=[Declare:ID])*;

MemberCallNoDot returns MemberCall: Ref=[Declare:ID] ({MemberCall.Previous=current} Ref=[Declare:ID])*;

interface RefOrKeyword extends Obj {
    Ref *Declare
}

// cross-reference and keyword alternative at the same position
RefOrKeyword: "choice" (Ref=[Declare:ID] | SELF);

interface Dedup extends Obj {
    Ref1 *Declare
    Ref2 *Declare
}

// two assignments to the same target type - dedup check
Dedup: "dedup" (Ref1=[Declare:ID] "x" | Ref2=[Declare:ID] "y");

// fully optional group in front of mandatory content
Opt returns Obj: "opt" (OPTIONAL AND)? THEN END;

token group SomeTokenGroup {
    ID "a" "b"
}

// token group after initial keyword - expect no completion
Group returns Obj: "group" SomeTokenGroup;

interface RefGroup extends Obj {
    Ref *Declare
}

// token group used to perform cross reference
RefGroup: "refgroup" Ref=[Declare:SomeTokenGroup];

interface RefAction extends Obj {
    Ref *Declare
}

// action used to change type
RefAction returns Obj: {RefAction} "action" Ref=[Declare:ID];

interface Scope extends Obj {
    Locals []Declare
    Item RefItem
    Others []RefItem
}

interface RefItem {
    Ref *Declare
}

// cross-reference in a nested rule, inside of a container with local symbols
Scope: "scope" LBRACE Locals+=Declare* "use" Item=RefItem (AND Others+=RefItem)* RBRACE;

RefItem: Ref=[Declare:ID];

interface Loop extends Obj {
    Locals []Declare
    Items []RefItem
    Nested []Loop
}

// cross-references in a loop without separators, inside of nested containers with local symbols
Loop: "loop" LBRACE (Locals+=Declare | Items+=RefItem | Nested+=Loop)* RBRACE;

interface Chain extends Obj {
    Items []ChainItem
}

interface ChainItem {
    Ref *Declare
    Previous ChainItem
}

// list of items without separators that are wrapped by a tree-rewriting action
Chain: "chain" LBRACE Items+=ChainItem* RBRACE;

ChainItem: Ref=[Declare:ID] ({ChainItem.Previous=current} AND Ref=[Declare:ID])*;

interface Infix extends Obj {
    Items []Expr
}

interface Expr {}

interface Operand extends Expr {
    Ref *Declare
}

interface Binary extends Expr {
    Left Expr
    Operator string
    Right Expr
}

// list of items without separators that are wrapped by an infix rule
Infix: "infix" LBRACE Items+=Binary* RBRACE;

infix Binary on Primary:
    "times"
    > "plus"

Primary returns Expr: {Operand} Ref=[Declare:ID];

interface Wrap extends Obj {
    Item WrapItem
}

interface WrapItem {}

interface WrapRef extends WrapItem {
    Ref *Declare
}

interface WrapGroup extends WrapItem {
    Elements []WrapItem
}

// items that a tree-rewriting action wraps into a list, using the property of the assignments that follow it
Wrap: "wrap" LBRACE Item=WrapGroup RBRACE;

WrapGroup returns WrapItem: WrapElement ({WrapGroup.Elements+=current} Elements+=WrapElement+)?;

WrapElement returns WrapItem: {WrapRef} Ref=[Declare:ID] | LBRACE WrapGroup RBRACE;

interface Shadow extends Obj {
    Right Expr
    Items []RefItem
}

// assignment to a property with the name of an operand of the infix rule that it calls
Shadow: "shadow" Right=Binary Items+=RefItem*;

interface Nest extends Obj {
    Locals []Declare
    Ref *Declare
    Children []Nest
}

// cross-reference next to nested containers of the same type
Nest: "nest" LBRACE (Locals+=Declare | Ref=[Declare:ID] | Children+=Nest)* RBRACE;

interface Ambig extends Obj {
    Name AmbigName
    Refs AmbigRefs
}

interface AmbigName {
    Name string
    Ref *Declare
}

interface AmbigRefs {
    Ref1 *Declare
    Ref *Declare
}

// alternatives that read the same token in different ways
Ambig: "ambig" (Name=AmbigName | Refs=AmbigRefs);

AmbigName: Name=ID Ref=[Declare:ID] FIRST;

AmbigRefs: Ref1=[Declare:ID] Ref=[Declare:ID] SECOND;

interface Retype extends Obj {
    Items []RetypeItem
}

interface RetypeItem {
    Inner RefItem
}

interface RetypeWrapper extends RetypeItem {}

// nested rule that changes the type of its node with an action
Retype: "retype" LBRACE Items+=RetypeItem* RBRACE;

RetypeItem: {RetypeWrapper} Inner=RefItem;

interface Dep extends Obj {
    A *Declare
    B *Declare
}

// two cross-references in one node, where the scope of B depends on the
// resolved A (see the scope provider)
Dep: "dep" A=[Declare:ID] B=[Declare:ID];

token DECLARE: "declare"
token FIRST: "first"
token SECOND: "second"
token LONG: "long"
token SELF: "self"
token COMMON: "common"
token THEN: "then"
token LBRACE: "{"
token RBRACE: "}"
token DOT: "."
token OPTIONAL: "optional"
token AND: "and"
token END: "end"

token WS: /[ \t\r\n]+/
token ID: /\w[\w0-9]*/

token mode default {
    keywords /^[a-z]+$/
    LBRACE
    RBRACE
    DOT
    ID

    hidden WS
}
