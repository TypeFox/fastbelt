grammar Fastbelt

interface Grammar {
    Name        string
    Rules       []ParserRule
    Composites  []CompositeRule
    Terminals   []TokenDecl
    TokenGroups []TokenGroup
    TokenModes  []TokenMode
    Interfaces  []Interface
}

entry Grammar: GRAMMAR Name=ID SEMICOLON?
    (
        Rules+=ParserRule
        | Terminals+=TokenDecl
        | TokenGroups+=TokenGroup
        | TokenModes+=TokenMode
        | Interfaces+=Interface
        | Composites+=CompositeRule
    )*

interface Interface {
    Name string
    Extends []*Interface
    Fields []Field
}

Interface:
    INTERFACE Name=ID (EXTENDS Extends+=[Interface:ID] (COMMA Extends+=[Interface:ID])*)? LEFTBRACE
        Fields+=Field*
    RIGHTBRACE

interface Field {
    Name string
    Type FieldType
}

interface FieldType {}

interface ArrayType extends FieldType {
    InternalType FieldType
}

interface ReferenceType extends FieldType {
    Type *Interface
}

interface SimpleType extends FieldType {
    Type *Interface
}

interface PrimitiveType extends FieldType {
    Type string
}

Field: Name=ID Type=FieldType

FieldType: SimpleType | ReferenceType | ArrayType | PrimitiveType

ArrayType: LEFTBRACKET RIGHTBRACKET InternalType=FieldType

ReferenceType: ASTERISK Type=[Interface:ID]

SimpleType: Type=[Interface:ID]

PrimitiveType: Type=(STRING | BOOL | COMPOSITE)

interface AbstractRule {
    Name string
}

interface AbstractRuleWithBody extends AbstractRule {
    Body Element
}

// Base type for TokenDecl and TokenGroup
interface AbstractTokenRule extends AbstractRule {
    Type    string
    Command TokenCommand
}

interface ParserRule extends AbstractRuleWithBody {
    Entry      bool
    ReturnType *Interface
}

ParserRule: (Entry?=ENTRY)? Name=ID (RETURNS ReturnType=[Interface:ID])? COLON Body=Alternatives SEMICOLON?

interface TokenDecl extends AbstractTokenRule {
    Content TokenElement
}

TokenDecl: Type=GroupType? TOKEN Name=ID COLON Content=TokenElement Command=TokenCommand? SEMICOLON?

interface TokenElement {}

TokenElement: RegexpTokenElement | KeywordTokenElement

interface RegexpTokenElement extends TokenElement {
    Regexp string
}

RegexpTokenElement: Regexp=RegexLiteral

interface KeywordTokenElement extends TokenElement {
    Keyword Keyword
}

KeywordTokenElement: Keyword=Keyword

interface TokenCommand {
    Type    string
    Mode    *TokenMode
    Default bool
}

TokenCommand: ARROW Type=(PUSH|POP|MODE) (LEFTPAREN (Mode=[TokenMode:ID] | Default?=DEFAULT) RIGHTPAREN)?;

interface TokenGroup extends AbstractTokenRule {
    TokenRefs        []*AbstractTokenRule
    Keywords         []Keyword
    KeywordSelectors []string
}

TokenGroup: Type=GroupType? TOKEN GROUP Name=ID LEFTBRACE
    (
        TokenRefs+=[AbstractTokenRule:ID]
        | Keywords+=Keyword
        | KEYWORDS KeywordSelectors+=RegexLiteral
    )*
RIGHTBRACE Command=TokenCommand? SEMICOLON?

interface TokenMode {
    Name    string
    Default bool
    Members []TokenModeMember
}

TokenMode: TOKEN MODE (Name=ID | Default?=DEFAULT) LEFTBRACE
    Members+=TokenModeMember*
RIGHTBRACE

interface TokenModeMember {}

TokenModeMember: TokenDeclUsage | TokenGroupUsage | TokenUsage | KeywordUsage | KeywordSelector

interface TokenDeclUsage extends TokenModeMember {
    Declaration TokenDecl
}

TokenDeclUsage: Declaration=TokenDecl

interface TokenGroupUsage extends TokenModeMember {
    Group TokenGroup
}

TokenGroupUsage: Group=TokenGroup

interface TokenUsage extends TokenModeMember {
    Type     string
    TokenRef *AbstractTokenRule
    Command  TokenCommand
}

TokenUsage: Type=GroupType? TokenRef=[AbstractTokenRule:ID] Command=TokenCommand? SEMICOLON?

interface KeywordUsage extends TokenModeMember {
    Type    string
    Keyword Keyword
    Command TokenCommand  
}

KeywordUsage: Type=GroupType? Keyword=Keyword Command=TokenCommand? SEMICOLON?

interface KeywordSelector extends TokenModeMember {
    Selector string
}

KeywordSelector: KEYWORDS Selector=RegexLiteral SEMICOLON?

interface Element {
    Cardinality string
}

interface Alternatives extends Assignable {
    Alts []Element
}

Alternatives returns Element: Group ({Alternatives.Alts+=current} (PIPE Alts+=Group)+)?

interface Group extends Element {
    Elements []Element
}

Group returns Element: Element ({Group.Elements+=current} Elements+=Element+)?

Element: (Keyword | Assignment | RuleCall | Action | LEFTPAREN Alternatives RIGHTPAREN) Cardinality=Cardinality?

interface Keyword extends Assignable {
    Value string
}

Keyword: Value=StringLiteral

interface Assignment extends Element {
    Property *Field
    Operator string
    Value    Assignable
}

Assignment: Property=[Field:ID] Operator=(PLUS_EQUALS | EQUALS | QUESTION_EQUALS) Value=Assignable

interface Assignable extends Element {}

Assignable: Keyword | RuleCall | CrossRef | LEFTPAREN AssignableAlternatives RIGHTPAREN

AssignableWithoutAlts returns Assignable: Keyword | RuleCall | CrossRef

AssignableAlternatives returns Assignable: AssignableWithoutAlts ({Alternatives.Alts+=current} (PIPE Alts+=AssignableWithoutAlts)+)?

interface CrossRef extends Assignable {
    Type *Interface
    Rule RuleCall
}

CrossRef: LEFTBRACKET Type=[Interface:ID] (COLON Rule=RuleCall)? RIGHTBRACKET

interface RuleCall extends Assignable {
    Rule *AbstractRule
}

RuleCall: Rule=[AbstractRule:ID]

interface Action extends Element {
    Type     *Interface
    Operator string
    Property *Field
}

Action: LEFTBRACE Type=[Interface:ID] (DOT Property=[Field:ID] Operator=(PLUS_EQUALS | EQUALS) CURRENT)? RIGHTBRACE

interface CompositeRule extends AbstractRuleWithBody {
}

CompositeRule: COMPOSITE Name=ID COLON Body=CompositeAlternatives SEMICOLON?

CompositeAlternatives returns Element: CompositeGroup ({Alternatives.Alts+=current} (PIPE Alts+=CompositeGroup)+)?

CompositeGroup returns Element: CompositeElement ({Group.Elements+=current} Elements+=CompositeElement+)?

CompositeElement returns Element: (Keyword | RuleCall | LEFTPAREN CompositeAlternatives RIGHTPAREN) Cardinality=Cardinality?

token ARROW: "->"
token LEFTPAREN: "("
token RIGHTPAREN: ")"
token ASTERISK: "*"
token PLUS: "+"
token PLUS_EQUALS: "+="
token COMMA: ","
token DOT: "."
token COLON: ":"
token SEMICOLON: ";"
token EQUALS: "="
token QUESTION: "?"
token QUESTION_EQUALS: "?="
token LEFTBRACKET: "["
token RIGHTBRACKET: "]"
token BOOL: "bool"
token COMMENT: "comment"
token COMPOSITE: "composite"
token CURRENT: "current"
token DEFAULT: "default"
token ENTRY: "entry"
token EXTENDS: "extends"
token GRAMMAR: "grammar"
token GROUP: "group"
token HIDDEN: "hidden"
token INTERFACE: "interface"
token KEYWORDS: "keywords"
token MODE: "mode"
token POP: "pop"
token PUSH: "push"
token RETURNS: "returns"
token STRING: "string"
token TOKEN: "token"
token LEFTBRACE: "{"
token PIPE: "|"
token RIGHTBRACE: "}"

token group Cardinality {
    ASTERISK
    PLUS
    QUESTION
}

token group GroupType {
    HIDDEN
    COMMENT
} 

// Move comments in front of RegexLiteral
token SL_COMMENT: /\/\/[^\r\n]*/
token ML_COMMENT: /\/\*[\s\S]*?\*\//

token StringLiteral: /"[^"]*"/
token ID: /[a-zA-Z_][a-zA-Z0-9_]*/
token RegexLiteral: /\/([^\r\n\[\/\\]|\\.|\[([^\r\n\]\\]|\\.)*\])+\//
token WS: /[ \n\r\t]+/

token mode default {
    GroupType
    Cardinality
    ARROW
    LEFTPAREN
    RIGHTPAREN
    ASTERISK
    PLUS
    PLUS_EQUALS
    COMMA
    DOT
    COLON
    SEMICOLON
    EQUALS
    QUESTION
    QUESTION_EQUALS
    LEFTBRACKET
    RIGHTBRACKET
    BOOL
    COMMENT
    COMPOSITE
    CURRENT
    DEFAULT
    ENTRY
    EXTENDS
    GRAMMAR
    GROUP
    HIDDEN
    INTERFACE
    KEYWORDS
    MODE
    POP
    PUSH
    RETURNS
    STRING
    TOKEN
    LEFTBRACE
    PIPE
    RIGHTBRACE
    comment SL_COMMENT
    comment ML_COMMENT
    StringLiteral
    ID
    RegexLiteral
    hidden WS
}