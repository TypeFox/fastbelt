grammar Arithmetics

interface Module {
    Name string
    Statements []Statement
}

interface Statement{}

interface AbstractDefinition {
    Name string
}

interface Definition extends AbstractDefinition, Statement {
    Args []DeclaredParameter
    Expression Expression
}

interface DeclaredParameter extends AbstractDefinition {
}

interface Evaluation extends Statement {
    Expression Expression
}

interface Expression {}

interface BinaryExpression extends Expression {
    Left Expression
    Operator string //"%" | "*" | "+" | "-" | "/" | "^"
    Right Expression
}

interface FunctionCall extends Expression {
    Args []Expression
    Callable *AbstractDefinition
}

interface NumberLiteral extends Expression {
    Value string
}

entry Module returns Module:
    "module" Name=ID
    Statements+=Statement*

Statement returns Statement:
    Definition | Evaluation

Definition:
    "def" Name=ID ("(" Args+=DeclaredParameter ("," Args+=DeclaredParameter)* ")")?
    ":" Expression=Expression ";"

DeclaredParameter:
    Name=ID

Evaluation:
    Expression=Expression ";"

Expression:
    BinaryExpression

infix BinaryExpression on PrimaryExpression:
    "%"
    > right assoc "^"
    > Multiplication
    > Addition

// Tests that Fastbelt can handle operators nested in token groups
token group Multiplication {
    "*"
    "/"
}

token group Addition {
    "+"
    "-"
}

PrimaryExpression returns Expression:
    "(" Expression ")" |
    {NumberLiteral} Value=NUMBER |
    {FunctionCall} Callable=[AbstractDefinition:ID] ("(" Args+=Expression ("," Args+=Expression)* ")")?

token ID: /[_a-zA-Z][\w_]*/
token NUMBER: /[0-9]+(\.[0-9]*)?/

hidden token WS: /\s+/
comment token ML_COMMENT: /\/\*[\s\S]*?\*\//
hidden token SL_COMMENT: /\/\/[^\n\r]*/
