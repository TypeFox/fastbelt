grammar Arithmetics

interface Module {
    Name string
    Statements []Statement
}

interface Statement{}

interface AbstractDefinition {
    Name string
}

interface Definition extends AbstractDefinition, Statement {
    Args []DeclaredParameter
    Expression Expression
}

interface DeclaredParameter extends AbstractDefinition {
}

interface Evaluation extends Statement {
    Expression Expression
}

interface Expression {}

interface BinaryExpression extends Expression {
    Left Expression
    Operator string //"%" | "*" | "+" | "-" | "/" | "^"
    Right Expression
}

interface FunctionCall extends Expression {
    Args []Expression
    Callable *AbstractDefinition
}

interface NumberLiteral extends Expression {
    Value string
}

entry Module returns Module:
    MODULE Name=ID
    Statements+=Statement*

Statement returns Statement:
    Definition | Evaluation

Definition:
    DEF Name=ID (LPAREN Args+=DeclaredParameter (COMMA Args+=DeclaredParameter)* RPAREN)?
    COLON Expression=Expression SEMICOLON

DeclaredParameter:
    Name=ID

Evaluation:
    Expression=Expression SEMICOLON

Expression:
    Addition

Addition returns Expression:
    Multiplication ({BinaryExpression.Left=current} Operator=(PLUS | MINUS) Right=Multiplication)*

Multiplication returns Expression:
    Exponentiation ({BinaryExpression.Left=current} Operator=(STAR | SLASH) Right=Exponentiation)*

Exponentiation returns Expression:
    Modulo ({BinaryExpression.Left=current} Operator=CARET Right=Modulo)*

Modulo returns Expression:
    PrimaryExpression ({BinaryExpression.Left=current} Operator=PERCENT Right=PrimaryExpression)*

PrimaryExpression returns Expression:
    LPAREN Expression RPAREN |
    {NumberLiteral} Value=NUMBER |
    {FunctionCall} Callable=[AbstractDefinition:ID] (LPAREN Args+=Expression (COMMA Args+=Expression)* RPAREN)?

token MODULE: "module"
token DEF: "def"
token LPAREN: "("
token RPAREN: ")"
token COMMA: ","
token COLON: ":"
token SEMICOLON: ";"
token PLUS: "+"
token MINUS: "-"
token STAR: "*"
token SLASH: "/"
token CARET: "^"
token PERCENT: "%"

token ID: /[_a-zA-Z][\w_]*/
token NUMBER: /[0-9]+(\.[0-9]*)?/

token WS: /\s+/
token ML_COMMENT: /\/\*[\s\S]*?\*\//
token SL_COMMENT: /\/\/[^\n\r]*/

token mode default {
    MODULE
    DEF
    LPAREN
    RPAREN
    COMMA
    COLON
    SEMICOLON
    PLUS
    MINUS
    STAR
    SLASH
    CARET
    PERCENT

    ID
    NUMBER
    hidden WS
    comment ML_COMMENT
    comment SL_COMMENT
}
