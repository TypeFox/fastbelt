grammar StatemachineModel

interface Statemachine {
    Name string
    Events []Event
    Commands []Command
    Init *State
    States []State
}

entry Statemachine returns Statemachine:
    STATEMACHINE
    Name=ID
    (EVENTS
        Events+=Event+)?
    (COMMANDS
      Commands+=Command+)?
    INITIALSTATE
    Init=[State:ID]
    States+=State*

interface Event {
    Name string
}

Event returns Event:
    Name=ID

interface Command {
    Name string
}

Command returns Command:
    Name=ID

interface State {
    Name string
    Actions []*Command
    Transitions []Transition
}

State returns State:
    STATE Name=ID
        (ACTIONS LBRACE Actions+=[Command:ID]+ RBRACE)?
        Transitions+=Transition*
    END

interface Transition {
    Event *Event
    State *State
}

Transition returns Transition:
    Event=[Event:ID] ARROW
    State=[State:ID]

token STATEMACHINE: "statemachine"
token EVENTS: "events"
token COMMANDS: "commands"
token INITIALSTATE: "initialstate"
token STATE: "state"
token ACTIONS: "actions"
token LBRACE: "{"
token RBRACE: "}"
token ARROW: "=>"
token END: "end"

token ID: /[_a-zA-Z][\w_]*/
token WS: /\s+/
token ML_COMMENT: /\/\*[\s\S]*?\*\//
token SL_COMMENT: /\/\/[^\n\r]*/

token mode default {
    STATEMACHINE
    EVENTS
    COMMANDS
    INITIALSTATE
    STATE
    ACTIONS
    LBRACE
    RBRACE
    ARROW
    END

    ID
    hidden WS
    comment ML_COMMENT
    comment SL_COMMENT
}